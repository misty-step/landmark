#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "${ROOT}"

npm ci --no-fund --no-audit
bin/check-architecture
bin/check-model-pin-freshness
cargo fmt --check
cargo clippy --locked --all-targets -- -D warnings
cargo test --locked
ci_event="${LANDMARK_CI_EVENT:-${GITHUB_EVENT_NAME:-}}"
pr_base_sha="${LANDMARK_PR_BASE_SHA:-}"
pr_head_ref="${LANDMARK_PR_HEAD_REF:-${GITHUB_HEAD_REF:-}}"
pr_head_repo="${LANDMARK_PR_HEAD_REPO:-}"
repository="${LANDMARK_REPOSITORY:-${GITHUB_REPOSITORY:-}}"
release_branch="${LANDMARK_RELEASE_BRANCH:-landmark/self-release}"
tag_ref="${LANDMARK_VERSION_REFERENCE:-HEAD}"
candidate_args=()
if [ "${ci_event}" = "pull_request" ] && [ -n "${pr_base_sha}" ]; then
  tag_ref="${pr_base_sha}"
  if [ "${pr_head_ref}" = "${release_branch}" ] && [ "${pr_head_repo}" = "${repository}" ]; then
    candidate_args+=(--allow-release-candidate)
  fi
fi
if git remote get-url origin >/dev/null 2>&1; then
  git fetch --tags --force origin
  if [ "${tag_ref}" = "HEAD" ] && git show-ref --verify --quiet refs/remotes/origin/master; then
    tag_ref="origin/master"
  fi
fi
if [ "${#candidate_args[@]}" -gt 0 ]; then
  cargo run --locked -p landmark -- check-version-sync --reference "${tag_ref}" "${candidate_args[@]}"
else
  cargo run --locked -p landmark -- check-version-sync --reference "${tag_ref}"
fi
cargo run --locked -p landmark -- check-action-contract
cargo run --locked -p landmark -- setup --repo-root . --output-dir .landmark/setup
cargo run --locked -p landmark -- replay-action --evidence-dir .landmark/replay
if command -v rustup >/dev/null 2>&1; then
  rustup target add x86_64-unknown-linux-musl
fi
if [ "$(uname -s)" = "Linux" ]; then
  bin/build-linux-action
else
  echo "non-Linux host: skipping x86_64-unknown-linux-musl build check; the release workflow's build-release-assets matrix builds and publishes it"
fi

if command -v actionlint >/dev/null 2>&1; then
  actionlint
else
  echo "warning: actionlint not found; install actionlint for local workflow lint parity" >&2
fi

git diff --check

# Exercise the semantic-release stack on a throwaway repo so dependency
# majors cannot merge without proving they load, analyze, and generate
# notes (landmark-semrel-dryrun-proof).
if [ -d node_modules/semantic-release ]; then
  # The fixture origin and the working clone share HEAD so semantic-release
  # treats the branch as up to date and actually runs verify/analyze/notes
  # instead of short-circuiting on a stale-branch check (which exits 0 even
  # with a broken analyzer).
  semrel_fix="$(mktemp -d)"
  git init -q --bare -b master "$semrel_fix/origin.git"
  git clone -q "$semrel_fix/origin.git" "$semrel_fix/repo"
  git -C "$semrel_fix/repo" config user.email gate@localhost
  git -C "$semrel_fix/repo" config user.name gate
  echo "# proof" > "$semrel_fix/repo/README.md"
  git -C "$semrel_fix/repo" add -A
  git -C "$semrel_fix/repo" commit -qm "chore: base"
  git -C "$semrel_fix/repo" tag v0.1.0
  git -C "$semrel_fix/repo" push -q origin master
  git -C "$semrel_fix/repo" push -q origin v0.1.0
  echo "feat(proof): exercise the semantic-release stack" > "$semrel_fix/repo/proof.txt"
  git -C "$semrel_fix/repo" add -A
  git -C "$semrel_fix/repo" commit -qm "feat(proof): exercise the semantic-release stack"
  cat > "$semrel_fix/repo/.releaserc.json" <<JSON
{
  "repositoryUrl": "file://$semrel_fix/origin.git",
  "branches": ["master"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/git", { "assets": ["CHANGELOG.md"] }]
  ]
}
JSON
  semrel_log="$(mktemp)"
  if ! (
    cd "$semrel_fix/repo" &&
    # Strip Actions PR-trigger variables: semantic-release skips analysis
    # entirely on pull_request events, and this proof must run everywhere.
    unset GITHUB_EVENT_NAME GITHUB_ACTIONS
    CI=true "$ROOT/node_modules/.bin/semantic-release" --dry-run
  ) | tee "$semrel_log"; then
    echo "::error::semantic-release dry-run proof failed; the release stack cannot load or analyze"
    rm -rf "$semrel_fix" "$semrel_log"
    exit 1
  fi
  if ! grep -q "The next release version is 0.2.0" "$semrel_log"; then
    echo "::error::semantic-release dry-run never analyzed commits; analyzer proof inconclusive"
    rm -rf "$semrel_fix" "$semrel_log"
    exit 1
  fi
  rm -rf "$semrel_fix" "$semrel_log"
fi
